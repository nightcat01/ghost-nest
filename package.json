{
  "name": "ghost-nest",
  "version": "0.1.0",
  "description": "A lightweight browser runtime for interactive ghost-style characters.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ghost-nest": "./bin/ghost-nest.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/characters/*",
    "dist/characters/index.*",
    "dist/characters/rine",
    "dist/characters/mira",
    "src/characters/rine/assets/**/*.png",
    "src/characters/rine/assets/**/*.webp",
    "src/characters/rine/assets/**/*.jpg",
    "src/characters/rine/assets/**/*.jpeg",
    "src/characters/rine/assets/**/*.gif",
    "src/characters/rine/assets/**/*.svg",
    "src/characters/rine/assets/**/*.avif",
    "ghost-nest.extensions.json",
    "index.html",
    "dev-assets.html",
    "dev-character.html",
    "dev-character-create.html",
    "dev-character-expression.html",
    "dev-character-dialogue.html",
    "dev-character-hitbox.html",
    "dev-character-set.html",
    "dev-character-scene.html",
    "dev-character-composition.html",
    "dev-menu-settings.html",
    "dev-fortune-embed.html",
    "dev-nanika-mapping.html",
    "dev-assets-crop.html",
    "dev-assets-comfy.html",
    "dev-assets-layer.html",
    "server.cjs",
    "styles.css",
    "docs/runtime-embed-guide.md",
    "docs/nanika-postgres",
    "ASSET_GENERATOR_SETUP.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightcat01/ghost-nest.git"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/postbuild.mjs",
    "dev": "node server.cjs",
    "check": "tsc --noEmit",
    "verify:ui": "node scripts/verify-ui.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5.8.3"
  }
}
